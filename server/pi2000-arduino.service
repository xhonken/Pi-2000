[Unit]
Description=Pi-Arduino
After=network-online.target
Wants=network-online.target

[Service]
User=pi2000-admin
Group=pi2000-admin
SupplementaryGroups=dialout
WorkingDirectory=/opt/pi2000-admin
ExecStart=/opt/pi2000-admin/venv/bin/python /opt/pi2000-admin/arduino_service.py
EnvironmentFile=/etc/pi2000web/runtime.env
Environment=WIN2K_STATE=/var/lib/pi2000-admin
RuntimeDirectory=pi2000-arduino
RuntimeDirectoryMode=0700
MemoryHigh=1536M
MemoryMax=2048M
MemorySwapMax=128M
CPUQuota=150%
TasksMax=128
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi2000-admin
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
