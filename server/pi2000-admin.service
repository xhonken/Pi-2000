[Unit]
Description=Pi-2000 administration and SSH terminal
After=network-online.target pi2000-sessions.service
Wants=network-online.target pi2000-sessions.service

[Service]
Environment=PI2000_ACCOUNTS_SOCKET=/run/pi2000-accounts/control.sock
User=pi2000-admin
Group=pi2000-admin
SupplementaryGroups=pi2000-phpmyadmin
WorkingDirectory=/opt/pi2000-admin
ExecStart=/opt/pi2000-admin/venv/bin/python /opt/pi2000-admin/app.py
EnvironmentFile=/etc/pi2000web/runtime.env
Environment=PI2000_STATE=/var/lib/pi2000-admin
Environment=PI2000_ARDUINO_SOCKET=/run/pi2000-arduino/worker.sock
Environment=PI2000_WORKER_SOCKET=/run/pi2000-sessions/worker.sock
MemoryMax=512M
TasksMax=128
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi2000-admin
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
