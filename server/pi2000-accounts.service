[Unit]
Description=Pi-2000 system account broker
After=local-fs.target
Before=pi2000-admin.service pi2000-sessions.service

[Service]
Type=simple
User=root
Group=pi2000-admin
ExecStart=/opt/pi2000-admin/venv/bin/python /opt/pi2000-admin/account_service.py serve
RuntimeDirectory=pi2000-accounts
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
PrivateTmp=true
ProtectSystem=true
ReadWritePaths=/etc /var/lib/pi2000-accounts /var/lib/pi2000-admin /home /var/spool
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LimitCORE=0
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
