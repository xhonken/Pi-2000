[Unit]
Description=Pi-2000 persistent application sessions
After=network-online.target
Wants=network-online.target

[Service]
Environment=WIN2K_ACCOUNTS_SOCKET=/run/pi2000-accounts/control.sock
User=pi2000-admin
Group=pi2000-admin
WorkingDirectory=/opt/pi2000-admin
ExecStart=/opt/pi2000-admin/venv/bin/python /opt/pi2000-admin/app.py
EnvironmentFile=/etc/pi2000web/runtime.env
Environment=WIN2K_STATE=/var/lib/pi2000-admin
Environment=WIN2K_SESSION_WORKER=1
Environment=WIN2K_CGROUP_LIMITS=1
RuntimeDirectory=pi2000-sessions
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi2000-admin /sys/fs/cgroup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Delegate=memory pids cpu
MemoryHigh=4G
MemoryMax=5G
TasksMax=1100
CPUQuota=300%
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
