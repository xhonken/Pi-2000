# Managed by Pi-2000Web. Edit /etc/pi2000web/config.toml, then run pi2000web configure.
{
    admin unix//var/lib/caddy/win2k-admin/control.sock
}

@PUBLIC_URL@ {
@BIND@    @TLS@
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy same-origin
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    }
    @desktop path / /index.html
    header @desktop Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
    handle /api/* {
        reverse_proxy 127.0.0.1:8765
    }
    handle {
        root * /srv/win2k
        file_server
    }
}
