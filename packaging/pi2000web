#!/bin/sh
if [ "${1:-}" = workers ]; then
    shift
    exec /opt/pi2000-admin/venv/bin/python /opt/pi2000-admin/maintenance.py "$@"
fi
if [ "${1:-}" = recovery ]; then
    shift
    exec /opt/pi2000-admin/venv/bin/python /opt/pi2000-admin/recovery.py "$@"
fi
exec /usr/bin/python3 /usr/lib/pi2000web/package_setup.py "$@"
